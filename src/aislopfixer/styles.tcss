/* ===== aislopfixer — global theme =====
   Palette lives in theme.py; this file mirrors those tokens:
   bg #0b0e14 · panel #11151f · panel-alt #0d111a · border #232a38
   text #cdd6f4 · dim #7b8496 · faint #5b647a · accent #36e2e6           */

Screen {
    background: #0b0e14;
    color: #cdd6f4;
    layers: base guard;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-background: #0b0e14;
    scrollbar-background-hover: #0b0e14;
    scrollbar-background-active: #0b0e14;
    scrollbar-color: #232a38;
    scrollbar-color-hover: #36e2e6;
    scrollbar-color-active: #36e2e6;
}

/* ---------- Footer: teal keys on the sunken surface ---------- */
Footer {
    background: #0d111a;
    color: #7b8496;
}
FooterKey {
    background: #0d111a;
}
FooterKey:hover {
    background: #1b2433;
}
FooterKey > .footer-key--key {
    color: #36e2e6;
    background: #0d111a;
    text-style: bold;
}
FooterKey > .footer-key--description {
    color: #7b8496;
    background: #0d111a;
}

/* ---------- Inputs: calm idle border, accent on focus ---------- */
Input {
    background: #0d111a;
    border: tall #232a38;
}
Input:focus {
    border: tall #36e2e6;
}

/* ---------- Toasts ---------- */
Toast {
    background: #11151f;
    border-left: outer #36e2e6;
}
Toast.-warning {
    border-left: outer #fbbf24;
}
Toast.-error {
    border-left: outer #f87171;
}

/* ---------- Responsive guard (too-small overlay) ---------- */
#guard {
    layer: guard;
    width: 100%;
    height: 100%;
    background: #0b0e14;
    content-align: center middle;
    display: none;
}
#guard.on {
    display: block;
}

/* ---------- Splash ---------- */
SplashScreen {
    align: center middle;
}
#splash-box {
    width: 84;
    height: auto;
    align: center middle;
    padding: 2 4;
}
Logo {
    width: 100%;
}
Typewriter {
    width: 100%;
    margin-top: 1;
}
#splash-meta {
    width: 100%;
    content-align: center middle;
    color: #5b647a;
    margin-top: 1;
}
#splash-hint {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: #36e2e6;
    margin-top: 2;
}
#splash-version {
    dock: bottom;
    width: 100%;
    content-align: right bottom;
    color: #5b647a;
    padding: 0 1 1 0;
}

/* ---------- Path ---------- */
PathScreen {
    align: center middle;
}
#path-box {
    width: 68;
    height: auto;
    padding: 2 4;
    border: round #36e2e6;
    border-title-color: #36e2e6;
    border-title-align: left;
    background: #11151f;
}
#path-title {
    text-style: bold;
    color: #36e2e6;
}
#path-sub {
    color: #7b8496;
    margin-bottom: 1;
}
#path-input {
    margin: 1 0;
}
#path-error {
    height: 1;
}
#path-hint {
    color: #5b647a;
    margin-top: 1;
}

/* ---------- Scan ---------- */
ScanScreen {
    align: center middle;
}
#scan-box {
    width: 84;
    height: auto;
    padding: 1 4;
    border: round #8b5cf6;
    border-title-color: #a78bfa;
    border-title-align: left;
    background: #11151f;
}
#scan-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: #a78bfa;
}
#scan-target {
    width: 100%;
    height: 1;
    content-align: center middle;
    margin-bottom: 1;
}
#scan-spinner {
    height: 1;
}
#scan-prog {
    width: 100%;
    margin-top: 1;
}
#scan-prog Bar > .bar--bar {
    color: #36e2e6;
    background: #232a38;
}
#scan-prog Bar > .bar--complete {
    color: #4ade80;
}
#scan-prog PercentageStatus {
    color: #7b8496;
}
#scan-count {
    width: 100%;
    height: 1;
}
#scan-pulse {
    height: 1;
    margin-top: 1;
}
#scan-current {
    height: 1;
    color: #7b8496;
}
#scan-counters {
    height: 5;
    margin-top: 1;
    border-top: solid #232a38;
    padding-top: 1;
}
.cat-counter {
    width: 1fr;
    height: auto;
}

/* ---------- Results ---------- */

/* ---------- Report screen ---------- */
ReportScreen {
    layout: vertical;
}
#rep-head {
    height: auto;
    padding: 1 2;
    background: #11151f;
    border: round #232a38;
    border-title-color: #36e2e6;
    border-title-style: bold;
    margin: 0 1;
}
#rep-body {
    height: 1fr;
    margin: 0 1 0 1;
}
#rep-left {
    width: 52%;
    height: 1fr;
}
#rep-axes {
    height: auto;
    padding: 1 1;
    background: #0d111a;
    border: round #232a38;
    border-title-color: #7b8496;
}
#rep-list {
    height: 1fr;
    background: #0d111a;
    border: round #232a38;
    border-title-color: #7b8496;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}
#rep-list:focus {
    border: round #36e2e6;
}
#rep-list > .option-list--option-highlighted {
    background: #1b2433;
    text-style: bold;
}
#rep-detail {
    width: 48%;
    height: 1fr;
    background: #0d111a;
    border: round #232a38;
    border-title-color: #7b8496;
    padding: 1 2;
}
#rep-detail-body {
    height: auto;
}

/* ---------- System screen ---------- */
SystemScreen {
    layout: vertical;
}
#sys-body {
    height: 1fr;
    margin: 1 1 0 1;
}
#sys-col {
    width: 44%;
}
#sys-arch {
    height: 8;
    background: #11151f;
    border: round #232a38;
    border-title-color: #7b8496;
    padding: 0 1;
}
#sys-left {
    width: 100%;
    background: #0d111a;
    border: round #232a38;
    border-title-color: #36e2e6;
    border-title-style: bold;
    padding: 1 2;
}
#sys-system {
    height: auto;
}
#sys-right {
    width: 56%;
}
#sys-plan {
    height: auto;
    padding: 1 2;
    background: #11151f;
    border: round #232a38;
    border-title-color: #7b8496;
}
#sys-preview {
    height: 1fr;
    background: #0d111a;
    border: round #232a38;
    border-title-color: #7b8496;
    padding: 1 2;
}
#sys-preview-body {
    height: auto;
}

/* ---------- Summary screen ---------- */
SummaryScreen {
    align: center middle;
}
#sum-box {
    width: 72;
    height: auto;
    padding: 1 3;
    background: #11151f;
    border: round #232a38;
    border-title-color: #36e2e6;
    border-title-style: bold;
}
#sum-title {
    height: auto;
    padding: 0 0 1 0;
}
#sum-delta {
    height: auto;
    padding: 0 0 1 0;
}
#sum-remaining {
    height: auto;
}
#sum-keys {
    height: auto;
    padding: 1 0 0 0;
}
